{
  "name": "profile-picker",
  "displayName": "Profile Picker",
  "description": "Selector de perfiles al iniciar VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  "onStartupFinished",
  "onCommand:profile-picker.abrirSelector"
],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "profile-picker.abrirSelector",
        "title": "Profile Picker: Abrir Selector"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}